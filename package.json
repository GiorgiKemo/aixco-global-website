    "smoke:title-motion": "node scripts/verify-title-animations.mjs",
    "smoke:transitions": "node scripts/verify-section-transitions.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:i18n": "node scripts/verify-localizations.mjs",
    "test:fonts": "node scripts/verify-font-glyphs.mjs",
    "test:watch": "vitest"
