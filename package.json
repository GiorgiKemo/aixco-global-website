    "build": "next build",
    "build:dev": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "preview": "next start -p 4173",
    "smoke": "node scripts/render-smoke.mjs",
    "smoke:locales": "node scripts/render-locales-smoke.mjs",
    "smoke:languages": "node scripts/verify-language-layout.mjs",
    "smoke:boundaries": "node scripts/verify-section-content-boundaries.mjs",
    "smoke:dubai": "node scripts/verify-dubai-scroll.mjs",
    "smoke:dubai-metrics": "node scripts/verify-dubai-metric-layout.mjs",
    "smoke:nav": "node scripts/verify-nav-scale.mjs",
    "smoke:mobile": "node scripts/verify-mobile-experience.mjs",
    "smoke:forms": "node scripts/verify-contact-forms.mjs",
