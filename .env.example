# Public site URL used for canonical metadata, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://aixco-global-website.vercel.app
SITE_URL=https://aixco-global-website.vercel.app

# Supabase public browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server/admin clients. Prefer SUPABASE_URL + SUPABASE_SECRET_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin dashboard authentication.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true

# Optional contact-form email notifications via Resend.
# When configured, Schedule a Call / Send an Email submissions are stored in Supabase
# and also emailed to LEAD_NOTIFICATION_TO.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM="AIXCO Website <leads@aixco.global>"
LEAD_NOTIFICATION_TO=info@aixco.global
