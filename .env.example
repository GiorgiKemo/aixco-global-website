# Public site URL used for canonical metadata, sitemap, and robots output.
NEXT_PUBLIC_SITE_URL=https://www.aixco.global
SITE_URL=https://www.aixco.global

# Supabase public browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server/admin clients. Prefer SUPABASE_URL + SUPABASE_SECRET_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin dashboard authentication. Use "migration" only while existing admins
# are being invited and enrolling TOTP. Change to "identity" after rollout.
ADMIN_AUTH_MODE=migration
ADMIN_AUTH_ROLE=admin

# Temporary shared-password fallback, read only in ADMIN_AUTH_MODE=migration.
# Use at least 16 characters for the password and 32 random characters for the
# session secret. Remove both after switching to identity mode.
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true

# Required production contact pipeline configuration. Contact requests are stored
# transactionally with a durable email outbox and then delivered by the cron worker.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM="AIXCO Website <notifications@send.aixco.global>"
LEAD_NOTIFICATION_TO=info@aixco.global

# Generate each with at least 32 cryptographically random characters. CRON_SECRET
# authenticates /api/cron/contact-email-deliveries. LEAD_CAPTURE_HASH_SECRET HMACs
# IP and recipient identities before distributed abuse-control storage.
CRON_SECRET=
LEAD_CAPTURE_HASH_SECRET=
